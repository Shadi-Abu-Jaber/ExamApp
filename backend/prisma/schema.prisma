generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LECTURER
  STUDENT
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_TEXT
  ESSAY
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

model User {
  id           String       @id @default(cuid())
  fullName     String
  email        String       @unique
  passwordHash String
  role         Role         @default(STUDENT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  exams        Exam[]       @relation("LecturerExams")
  submissions  Submission[]
  assignedExams ExamStudent[]
}

model Exam {
  id               String         @id @default(cuid())
  title            String
  description      String
  lecturerId       String
  lecturer         User           @relation(fields: [lecturerId], references: [id], name: "LecturerExams")
  durationMinutes  Int
  startTime        DateTime
  endTime          DateTime
  status           ExamStatus     @default(DRAFT)
  resultsPublished Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  questions        Question[]
  assignments      ExamStudent[]
  submissions      Submission[]
}

model Question {
  id           String           @id @default(cuid())
  examId       String
  exam         Exam             @relation(fields: [examId], references: [id])
  questionText String
  questionType QuestionType
  points       Int
  orderIndex   Int
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  options      QuestionOption[]
  answers      Answer[]
}

model QuestionOption {
  id           String   @id @default(cuid())
  questionId   String
  question     Question @relation(fields: [questionId], references: [id])
  optionText   String
  isCorrect    Boolean  @default(false)
}

model ExamStudent {
  id        String   @id @default(cuid())
  examId    String
  studentId String
  exam      Exam     @relation(fields: [examId], references: [id])
  student   User     @relation(fields: [studentId], references: [id])
  createdAt DateTime @default(now())

  @@unique([examId, studentId])
}

model Submission {
  id          String           @id @default(cuid())
  examId      String
  studentId   String
  status      SubmissionStatus @default(IN_PROGRESS)
  startedAt   DateTime         @default(now())
  submittedAt DateTime?
  totalScore  Float?           @default(0)
  feedback    String?
  exam        Exam             @relation(fields: [examId], references: [id])
  student     User             @relation(fields: [studentId], references: [id])
  answers     Answer[]
}

model Answer {
  id               String    @id @default(cuid())
  submissionId     String
  questionId       String
  answerText       String?
  selectedOptionId String?
  score            Float?    @default(0)
  feedback         String?
  submission       Submission @relation(fields: [submissionId], references: [id])
  question         Question   @relation(fields: [questionId], references: [id])

  @@unique([submissionId, questionId])
}
