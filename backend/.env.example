# ExamApp backend — environment variables.
# Copy this file to .env and adjust as needed.

# HTTP server
PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# PostgreSQL — local install (EDB / Homebrew)
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=examapp
