# ExamApp backend — environment variables.
# Copy this file to .env and adjust as needed.

# HTTP server
PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Authentication (JWT)
# ----------------------------------------------------------------------------
# Secret used to sign login/register tokens. Use a long, random string in
# production. If unset, the server falls back to an insecure dev secret and
# logs a warning on startup.
JWT_SECRET=dev-insecure-secret-change-me
JWT_EXPIRES_IN=7d

# ----------------------------------------------------------------------------
# PostgreSQL connection
# ----------------------------------------------------------------------------
# The same PG_* variables work for all three setups — only the values change:
#
#   1) Local Docker DB (recommended for dev) — `npm run db:up` in backend/.
#      Use the defaults below (postgres / postgres / examapp). Nothing else
#      to install; the container seeds itself on first start.
#
#   2) Local native install (EDB / Homebrew) — point at your local server and
#      set PG_PASSWORD to whatever you chose during installation.
#
#   3) Remote database (managed cloud PG) — set PG_HOST to the remote host and
#      fill in the credentials it gave you.
#
# If a native Postgres is already using 5432, start Docker on another port
# (PG_PORT=5433 here + `PG_PORT=5433 npm run db:up`) to avoid a clash.
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=examapp
